   "source": [
    "## Improved Dataset Splitting with Temporal Consistency\n",
    "\n",
    "We'll split our data into training and test sets, ensuring temporal consistency to prevent data leakage."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "def split_dataset_temporal(modeling_df, train_size=0.6, val_size=0.2, test_size=0.2):\n",
    "    \"\"\"Split the dataset into training, validation, and test sets with temporal consistency.\"\"\"\n",
    "    \n",
    "    if modeling_df is None or modeling_df.empty:\n",
    "        print(\"No data available for splitting\")\n",
    "        return None, None\n",
    "    \n",
    "    print(\"Starting temporal dataset splitting...\")\n",
    "    \n",
    "    # If we have timestamp information, use it for temporal splitting\n",
    "    # Otherwise, use a random split but with a note about potential data leakage\n",
    "    \n",
    "    # Separate features and target\n",
    "    target_col = 'view_count'\n",
    "    if target_col not in modeling_df.columns:\n",
    "        print(f\"Target column '{target_col}' not found in dataset\")\n",
    "        return None, None\n",
    "    \n",
    "    # Select features for modeling\n",
    "    # Include numerical features and some categorical features that we'll encode\n",
    "    feature_cols = [\n",
    "        'socdem_cluster', 'region_frequency', 'price', 'total_events', \n",
    "        'total_views', 'category_missing', 'subcategory_missing',\n",
    "        'user_item_view_count', 'days_since_last_view', 'view_recency_score',\n",
    "        'hour_sin', 'hour_cos', 'day_sin', 'day_cos'\n",
    "    ]\n",
    "    \n",
    "    # Add log-transformed features\n",
    "    log_features = ['total_events_log', 'total_views_log', 'user_item_view_count_log']\n",
    "    for feat in log_features:\n",
    "        if feat in modeling_df.columns:\n",
    "            feature_cols.append(feat)\n",
    "    \n",
    "    # Add min-max scaled features\n",
    "    minmax_features = ['price_minmax', 'item_age_days_minmax']\n",
    "    for feat in minmax_features:\n",
    "        if feat in modeling_df.columns:\n",
    "            feature_cols.append(feat)\n",
    "    \n",
    "    # Check which features actually exist in the dataset\n",
    "    feature_cols = [col for col in feature_cols if col in modeling_df.columns]\n",
    "    \n",
    "    if not feature_cols:\n",
    "        print(\"No features available for modeling\")\n",
    "        return None, None\n",
    "    \n",
    "    print(f\"Using features: {feature_cols}\")\n",
    "    \n",
    "    X = modeling_df[feature_cols]\n",
    "    y = modeling_df[target_col]\n",
    "    \n",
    "    # Handle missing values in features\n",
    "    X = X.fillna(0)\n",
    "    \n",
    "    # Sort by timestamp to ensure temporal order\n",
    "    if 'last_view_timestamp' in modeling_df.columns:\n",
    "        modeling_df = modeling_df.sort_values('last_view_timestamp').reset_index(drop=True)\n",
    "        print(\"Data sorted by timestamp for temporal splitting\")\n",
    "    else:\n",
    "        print(\"Warning: No timestamp column found. Using random split which may cause data leakage.\")\n",
    "        X_train, X_test, y_train, y_test = train_test_split(\n",
    "            X, y, test_size=test_size, random_state=RANDOM_STATE\n",
    "        )\n",
    "        print(f\"Training set: {X_train.shape[0]} samples\")\n",
    "        print(f\"Test set: {X_test.shape[0]} samples\")\n",
    "        print(\"Dataset splitting completed successfully.\")\n",
    "        return (X_train, X_test, y_train, y_test), feature_cols\n",
    "    \n",
    "    # Implement temporal splitting (60% train, 20% validation, 20% test)\n",
    "    n_samples = len(modeling_df)\n",
    "    train_end = int(n_samples * train_size)\n",
    "    val_end = int(n_samples * (train_size + val_size))\n",
    "    \n",
    "    # Split the data temporally\n",
    "    train_df = modeling_df[:train_end]\n",
    "    val_df = modeling_df[train_end:val_end]\n",
    "    test_df = modeling_df[val_end:]\n",
    "    \n",
    "    # Separate features and targets for each split\n",
    "    X_train = train_df[feature_cols]\n",
    "    y_train = train_df[target_col]\n",
    "    \n",
    "    X_val = val_df[feature_cols]\n",
    "    y_val = val_df[target_col]\n",
    "    \n",
    "    X_test = test_df[feature_cols]\n",
    "    y_test = test_df[target_col]\n",
    "    \n",
    "    # Handle missing values in features\n",
    "    X_train = X_train.fillna(0)\n",
    "    X_val = X_val.fillna(0)\n",
    "    X_test = X_test.fillna(0)\n",
    "    \n",
    "    print(f\"Training set: {X_train.shape[0]} samples\")\n",
    "    print(f\"Validation set: {X_val.shape[0]} samples\")\n",
    "    print(f\"Test set: {X_test.shape[0]} samples\")\n",
    "    \n",
    "    print(\"Dataset splitting completed successfully.\")\n",
    "    return (X_train, X_val, X_test, y_train, y_val, y_test), feature_cols\n",
    "\n",
    "def temporal_cross_validation(modeling_df, n_splits=5):\n",
    "    \"\"\"Implement temporal cross-validation to evaluate model performance over time.\"\"\"\n",
    "    \n",
    "    if modeling_df is None or modeling_df.empty:\n",
    "        print(\"No data available for cross-validation\")\n",
    "        return None\n",
    "    \n",
    "    print(\"Starting temporal cross-validation...\")\n",
    "    \n",
    "    # Sort by timestamp to ensure temporal order\n",
    "    if 'last_view_timestamp' in modeling_df.columns:\n",
    "        modeling_df = modeling_df.sort_values('last_view_timestamp').reset_index(drop=True)\n",
    "        print(\"Data sorted by timestamp for temporal cross-validation\")\n",
    "    else:\n",
    "        print(\"Warning: No timestamp column found. Results may not reflect temporal performance.\")\n",
    "    \n",
    "    # Create temporal splits\n",
    "    n_samples = len(modeling_df)\n",
    "    split_size = n_samples // n_splits\n",
    "    \n",
    "    cv_scores = []\n",
    "    \n",
    "    # Perform temporal cross-validation\n",
    "    for i in range(n_splits - 1):  # Leave last split as test set\n",
    "        # Define train and validation indices\n",
    "        train_end = (i + 1) * split_size\n",
    "        val_start = train_end\n",
    "        val_end = min(val_start + split_size, n_samples)\n",
    "        \n",
    "        # Skip if validation set would be empty\n",
    "        if val_start >= val_end:\n",
    "            continue\n",
    "        \n",
    "        # Split data\n",
    "        train_df = modeling_df[:train_end]\n",
    "        val_df = modeling_df[val_start:val_end]\n",
    "        \n",
    "        print(f\"Fold {i+1}: Train samples {len(train_df)}, Validation samples {len(val_df)}\")\n",
    "        \n",
    "        # For demonstration, we'll just calculate basic statistics\n",
    "        # In a full implementation, you would train and evaluate models here\n",
    "        train_mean_target = train_df['view_count'].mean()\n",
    "        val_mean_target = val_df['view_count'].mean()\n",
    "        \n",
    "        # Calculate a simple metric (difference in means)\n",
    "        score = abs(train_mean_target - val_mean_target)\n",
    "        cv_scores.append(score)\n",
    "        \n",
    "        print(f\"  Train mean target: {train_mean_target:.4f}\")\n",
    "        print(f\"  Validation mean target: {val_mean_target:.4f}\")\n",
    "        print(f\"  Score (abs diff): {score:.4f}\")\n",
    "    \n",
    "    if cv_scores:\n",
    "        mean_score = np.mean(cv_scores)\n",
    "        std_score = np.std(cv_scores)\n",
    "        print(f\"\\nTemporal CV Results:\")\n",
    "        print(f\"  Mean Score: {mean_score:.4f}\")\n",
    "        print(f\"  Std Score: {std_score:.4f}\")\n",
    "        print(f\"  Scores: {cv_scores}\")\n",
    "    \n",
    "    print(\"Temporal cross-validation completed.\")\n",
    "    return cv_scores\n",
    "\n",
    "# Split the dataset\n",
    "split_data, feature_cols = split_dataset_temporal(modeling_df)\n",
    "\n",
    "if split_data is not None:\n",
    "    X_train, X_val, X_test, y_train, y_val, y_test = split_data\n",
    "    print(\"\\nDataset splitting completed successfully\")\n",
    "    \n",
    "    # Perform temporal cross-validation\n",
    "    cv_scores = temporal_cross_validation(modeling_df)\n"
   ]
